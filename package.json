{
  "name": "learning-desk",
  "version": "1.0.0",
  "description": "Learning Desk - Express + EJS + MySQL",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/app.js",
    "dev": "tsx watch src/app.ts",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "license": "ISC",
  "dependencies": {
    "dotenv": "^18.0.8",
    "ejs": "^7.0.1",
    "express": "^5.3.0",
    "multer": "^2.4.0",
    "mysql2": "^3.24.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
