<div class="test-case border rounded p-3 mb-2">
  <div class="row g-2">
    <div class="col-md-6">
      <label class="form-label small" for="tc-<%= index %>-input">Input</label>
      <textarea class="form-control font-monospace" id="tc-<%= index %>-input" name="testCases[<%= index %>][input]"
                rows="3"><%= testCase.input %></textarea>
    </div>
    <div class="col-md-6">
      <label class="form-label small" for="tc-<%= index %>-expected">Expected output</label>
      <textarea class="form-control font-monospace" id="tc-<%= index %>-expected" name="testCases[<%= index %>][expectedOutput]"
                rows="3"><%= testCase.expectedOutput %></textarea>
    </div>
  </div>
  <div class="d-flex justify-content-between align-items-center mt-2">
    <div class="form-check">
      <input class="form-check-input" type="checkbox" value="1" id="tc-<%= index %>-hidden"
             name="testCases[<%= index %>][isHidden]" <%= testCase.isHidden ? 'checked' : '' %>>
      <label class="form-check-label small" for="tc-<%= index %>-hidden">Hidden from the learner</label>
    </div>
    <button type="button" class="btn btn-sm btn-outline-danger" data-remove-test-case>Remove</button>
  </div>
</div>
